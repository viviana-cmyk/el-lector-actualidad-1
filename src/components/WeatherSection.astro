---
import weather from "../data/weather.json";

const groups = [
  { key: "colombia", label: "Colombia", i18n: null,          cities: weather.colombia },
  { key: "mundo",    label: "Mundo",    i18n: "weather_world", cities: weather.mundo },
];
---

<div class="weather-groups">
  {
    groups.map((group) => (
      <div class="weather-group">
        <h3 class="weather-group__title" data-i18n={group.i18n ?? undefined}>{group.label}</h3>
        <div class="weather-cards">
          {
            group.cities?.map((city) => (
              <div class="weather-card">
                <span class="weather-card__icon">{city.icon}</span>
                <span class="weather-card__city">
                  {city.city_en ? (
                    <>
                      <span data-l="es">{city.city}</span>
                      <span data-l="en">{city.city_en}</span>
                    </>
                  ) : city.city}
                </span>
                <span class="weather-card__temp">{city.temp}°C</span>
                <span class="weather-card__desc">
                  {city.description_en ? (
                    <>
                      <span data-l="es">{city.description}</span>
                      <span data-l="en">{city.description_en}</span>
                    </>
                  ) : city.description}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    ))
  }
</div>
