---
interface Props {
  generatedAt: string;
}

const { generatedAt } = Astro.props;

const formatted = new Intl.DateTimeFormat("es-CO", {
  timeZone: "America/Bogota",
  dateStyle: "long",
  timeStyle: "short",
}).format(new Date(generatedAt));
---

<p class="updated-note"><span data-i18n="last_update">Última actualización:</span> {formatted} <span data-i18n="last_update_tz">(hora de Colombia)</span></p>
