---
import "../styles/global.css";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  hideTopbar?: boolean;
}

const {
  title,
  description = "Recopilación sin ánimo de lucro de noticias de Colombia y el mundo, indicadores económicos y recomendados sobre seguridad, justicia y paz.",
  hideTopbar = false,
} = Astro.props;

const SITE = "https://el-lector.com";
const canonicalUrl = SITE + Astro.url.pathname.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/cat-logo.png")} type="image/png" />
    <!-- Open Graph / WhatsApp / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="El LECTOR" />
    <meta property="og:title" content={`${title} · El LECTOR`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/og-image.png`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · El LECTOR`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-image.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Poppins:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title} · El LECTOR</title>
    <slot name="head" />
    <script is:inline>try{document.documentElement.setAttribute('data-site-lang',localStorage.getItem('lang')||'es')}catch{}</script>
  </head>
  <body>
    <div class="lang-switcher" role="group" aria-label="Idioma / Language">
      <button class="lang-btn" data-lang="es">Español</button>
      <span class="lang-sep">·</span>
      <button class="lang-btn" data-lang="en">Inglés</button>
    </div>

    {!hideTopbar && (
      <header class="topbar">
        <div class="topbar__inner">
          <a class="topbar__brand" href={withBase("/")}>
            <img src={withBase("/cat-logo.png")} alt="" />
            El LECTOR
          </a>
          <nav class="topbar__nav">
            <a class="pill" href={withBase("/")} data-i18n="nav_home">Inicio</a>
            <a class="pill" href={withBase("/actualidad")} data-i18n="nav_news">Actualidad</a>
            <a class="pill" href={withBase("/reflexiones")} data-i18n="nav_reflections">Reflexiones del Lector</a>
            <a class="pill" href={withBase("/cifras")} data-i18n="nav_data">Datos y Cifras</a>
            <a class="pill pill--ghost" href={withBase("/recomendados")} data-i18n="nav_recommended">Recomendados</a>
          </nav>
        </div>
      </header>
    )}

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <span class="pin">📍</span>
        <div class="footer__brand">El LECTOR</div>
        <p data-i18n-html="footer_para">
          Recopilación sin ánimo de lucro en temas de seguridad, justicia y paz, realizada
          desde la curiosidad innata de los gatos. <strong>Lee, actualízate y edifica</strong>
          tus propias conjeturas a partir de datos, tendencias y contemporaneidad.
        </p>
        <img class="footer__cat" src={withBase("/cat-logo.png")} alt="El LECTOR" />
      </div>
    </footer>
  </body>
  <script>
    if (history.scrollRestoration) history.scrollRestoration = "manual";
    window.scrollTo({ top: 0, left: 0, behavior: "instant" });

    // ── i18n ──────────────────────────────────────────────────────────────────
    const T = {
      es: {
        nav_home: "Inicio", nav_news: "Actualidad",
        nav_reflections: "Reflexiones del Lector", nav_data: "Datos y Cifras",
        nav_recommended: "Recomendados",
        hero_subtitle: "Noticias, actualidad y más.....",
        section_story: "La noticia del día",
        section_indicators: "Indicadores económicos",
        section_weather: "Clima · principales ciudades",
        page_news: "Actualidad", page_news_byline: "Noticias",
        tab_colombia: "Colombia", tab_latam: "Latinoamérica",
        tab_mundo: "El Mundo", tab_tensions: "TOP 3 · Tensiones",
        trends_title: "Tendencias", trends_live: "● EN VIVO",
        trends_co: "Tendencias de hoy en Colombia",
        trends_world: "Tendencias de hoy en el mundo",
        tensions_empty: "Actualizando cada mañana a las 5:00 AM…",
        section_colombia: "Colombia", section_mundo: "Mundo", section_security: "Seguridad",
        featured_colombia: "🇨🇴 Colombia", featured_mundo: "🌍 El Mundo",
        read_more: "Leer artículo completo →",
        investigations: "Investigaciones", books: "Libros",
        page_reflections: "Reflexiones del Lector",
        last_update: "Última actualización:", last_update_tz: "(hora de Colombia)",
        audio_play: "Escuchar análisis", audio_pause: "Pausar", audio_resume: "Reanudar", audio_stop: "Detener",
        audio_slow: "Lento", audio_normal: "Normal", audio_fast: "Rápido", audio_voice: "Voz",
        cifras_kicker: "Dashboard de seguridad · Colombia",
        cifras_goto: "Ir a", cifras_ind: "Indicadores", cifras_map_anchor: "Mapa",
        cifras_lideres_anchor: "Líderes sociales",
        cifras_ind_title: "Indicadores por ciudad",
        cifras_map_title: "Mapa por tasa x100.000 hab.",
        cifras_top5_title: "Top 5 ciudades por delito · tasa x100.000 hab.",
        cifras_lideres_title: "Líderes sociales asesinados",
        cifras_crime: "Delito", cifras_city_label: "Ver por ciudad",
        crime_hom: "Homicidios", crime_hur: "Hurto personas", crime_ext: "Extorsión",
        crime_res: "Hurto residencias", crime_vif: "Violencia intrafamiliar", crime_aut: "Hurto automotores",
        no_headlines: "Sin titulares disponibles por ahora.",
        ind_dollar: "Dólar", ind_oil: "Petróleo", ind_coffee: "Café",
        weather_world: "Mundo",
        rank_x_co: "Colombia · Top 5", rank_tiktok_co: "TikTok · Colombia · Top 5", rank_pod_co: "Ranking podcasts · Colombia",
        rank_x_mundo: "Mundo · Top 5", rank_tiktok_mundo: "TikTok · Mundo · Top 5", rank_pod_mundo: "Ranking podcasts · Mundo",
        footer_para: "Recopilación sin ánimo de lucro en temas de seguridad, justicia y paz, realizada desde la curiosidad innata de los gatos. <strong>Lee, actualízate y edifica</strong> tus propias conjeturas a partir de datos, tendencias y contemporaneidad.",
      },
      en: {
        nav_home: "Home", nav_news: "News",
        nav_reflections: "Reader's Reflections", nav_data: "Data & Figures",
        nav_recommended: "Recommended",
        hero_subtitle: "News, current events and more.....",
        section_story: "Story of the day",
        section_indicators: "Economic indicators",
        section_weather: "Weather · main cities",
        page_news: "News", page_news_byline: "Headlines",
        tab_colombia: "Colombia", tab_latam: "Latin America",
        tab_mundo: "World News", tab_tensions: "TOP 3 · Tensions",
        trends_title: "Trends", trends_live: "● LIVE",
        trends_co: "Today's trends in Colombia",
        trends_world: "Today's global trends",
        tensions_empty: "Updating every morning at 5:00 AM…",
        section_colombia: "Colombia", section_mundo: "World", section_security: "Security",
        featured_colombia: "🇨🇴 Colombia", featured_mundo: "🌍 World",
        read_more: "Read full article →",
        investigations: "Investigations", books: "Books",
        page_reflections: "Reader's Reflections",
        last_update: "Last update:", last_update_tz: "(Colombia time)",
        audio_play: "Listen to analysis", audio_pause: "Pause", audio_resume: "Resume", audio_stop: "Stop",
        audio_slow: "Slow", audio_normal: "Normal", audio_fast: "Fast", audio_voice: "Voice",
        cifras_kicker: "Security Dashboard · Colombia",
        cifras_goto: "Go to", cifras_ind: "Indicators", cifras_map_anchor: "Map",
        cifras_lideres_anchor: "Social leaders",
        cifras_ind_title: "Indicators by city",
        cifras_map_title: "Map by rate per 100,000 inhabitants",
        cifras_top5_title: "Top 5 cities by crime · rate per 100,000",
        cifras_lideres_title: "Assassinated Social Leaders",
        cifras_crime: "Crime", cifras_city_label: "View by city",
        crime_hom: "Homicides", crime_hur: "Theft from persons", crime_ext: "Extortion",
        crime_res: "Residential theft", crime_vif: "Domestic violence", crime_aut: "Vehicle theft",
        no_headlines: "No headlines available right now.",
        ind_dollar: "Dollar", ind_oil: "Oil", ind_coffee: "Coffee",
        weather_world: "World",
        rank_x_co: "Colombia · Top 5", rank_tiktok_co: "TikTok · Colombia · Top 5", rank_pod_co: "Podcast Ranking · Colombia",
        rank_x_mundo: "World · Top 5", rank_tiktok_mundo: "TikTok · World · Top 5", rank_pod_mundo: "Podcast Ranking · World",
        footer_para: "Non-profit news compilation on security, justice &amp; peace. <strong>Read, update yourself and build</strong> your own perspective from data, trends and current events.",
      },
    };

function getLang() {
      try { return localStorage.getItem("lang") || "es"; } catch { return "es"; }
    }

    function applyLang(lang) {
      const t = T[lang] || T.es;
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.dataset.i18n;
        if (t[key] !== undefined) el.textContent = t[key];
      });
      document.querySelectorAll("[data-i18n-html]").forEach((el) => {
        const key = el.dataset.i18nHtml;
        if (t[key] !== undefined) el.innerHTML = t[key];
      });
      // Activar contenido bilingüe via CSS
      document.documentElement.setAttribute("data-site-lang", lang);
      document.documentElement.lang = lang;
      // Resaltar botón activo
      document.querySelectorAll(".lang-btn").forEach((b) => {
        b.classList.toggle("lang-btn--active", b.dataset.lang === lang);
      });
      try { localStorage.setItem("lang", lang); } catch {}
      try { if (typeof (window as any).__onLangChange === "function") (window as any).__onLangChange(lang); } catch {}
    }

    const savedLang = getLang();
    applyLang(savedLang);
    document.querySelectorAll(".lang-btn").forEach((b) => {
      b.addEventListener("click", () => applyLang(b.dataset.lang));
    });
  </script>
</html>
