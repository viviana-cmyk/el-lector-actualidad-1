---
import Layout from "../layouts/Layout.astro";
import IndicatorsBar from "../components/IndicatorsBar.astro";
import UpdatedNote from "../components/UpdatedNote.astro";
import FeaturedStory from "../components/FeaturedStory.astro";
import WeatherSection from "../components/WeatherSection.astro";
import { withBase } from "../lib/url";
import featured from "../data/featured.json";
import dailyinfo from "../data/dailyinfo.json";

const diaHoy = (dailyinfo as any).dia ?? null;
const diaHoyEN = (dailyinfo as any).dia_en ?? null;

const fechaHoy = new Date().toLocaleDateString("es-CO", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "America/Bogota",
});

const diaFecha = new Date((dailyinfo as any).generatedAt ?? Date.now());
const calMes = diaFecha.toLocaleDateString("es-CO", { month: "short", timeZone: "America/Bogota" }).toUpperCase().replace(".","");
const calDia = diaFecha.toLocaleDateString("es-CO", { day: "numeric", timeZone: "America/Bogota" });
---

<Layout title="Inicio" hideTopbar>
  <section class="hero" style={`background-image: linear-gradient(180deg, rgba(5,5,8,0.55) 0%, rgba(5,5,8,0.75) 55%, rgba(5,5,8,0.97) 100%), url('${withBase('/biblioteca.jpeg')}')`}>
    <div class="hero__inner">
      <img class="hero__cat" src={withBase("/cat-logo.png")} alt="El LECTOR" />

      <div class="hero__badge">● {fechaHoy}</div>

      <h1>El <span>LECTOR</span></h1>

      <p class="subtitle" data-i18n="hero_subtitle">Noticias, actualidad y más.....</p>

      <nav class="hero__nav">
        <a class="pill hero__pill--primary" href={withBase("/actualidad")} data-i18n="nav_news">Actualidad</a>
        <a class="pill hero__pill--primary" href={withBase("/reflexiones")} data-i18n="nav_reflections">Reflexiones del Lector</a>
        <a class="pill hero__pill--primary" href={withBase("/cifras")} data-i18n="nav_data">Datos y Cifras</a>
        <a class="pill pill--ghost" href={withBase("/recomendados")} data-i18n="nav_recommended">Recomendados</a>
      </nav>

      {diaHoy && (
        <div class="hero__diainfo">
          <div class="hero__cal">
            <span class="hero__cal-mes">{calMes}</span>
            <span class="hero__cal-dia">{calDia}</span>
          </div>
          <div class="hero__diainfo-body">
            <span class="hero__diainfo-title" data-l={diaHoyEN ? "es" : undefined}>{diaHoy.nombre}</span>
            {diaHoyEN && <span class="hero__diainfo-title" data-l="en">{diaHoyEN.nombre}</span>}
            <span class="hero__diainfo-desc" data-l={diaHoyEN ? "es" : undefined}>{diaHoy.descripcion}</span>
            {diaHoyEN && <span class="hero__diainfo-desc" data-l="en">{diaHoyEN.descripcion}</span>}
          </div>
        </div>
      )}
    </div>
  </section>

  <section id="inicio-contenido" class="section wrap">
    <h2 class="section__title" data-i18n="section_story">La noticia del día</h2>
    <p class="section__byline">El LECTOR</p>
    <FeaturedStory />
  </section>

  <section class="section wrap">
    <h2 class="section__title" data-i18n="section_indicators">Indicadores económicos</h2>
    <p class="section__byline">El LECTOR</p>
    <IndicatorsBar />
  </section>

  <section class="section wrap">
    <h2 class="section__title" data-i18n="section_weather">Clima · principales ciudades</h2>
    <p class="section__byline">El LECTOR</p>
    <WeatherSection />
  </section>

  <div class="wrap">
    <UpdatedNote generatedAt={featured.generatedAt} />
  </div>
</Layout>

<script>
  // Deshabilitar restauración de scroll del navegador para que siempre abra en el tope
  if (history.scrollRestoration) history.scrollRestoration = "manual";
  window.scrollTo({ top: 0, left: 0, behavior: "instant" });
</script>
